# Strata for a Tesla V100 (sm_70) + RTX 4090 (sm_89) box, CUDA 12.8 (branch v100-4090 of 0ics-srls/Strata).
# Upstream Strata targets CUDA 13 and sm_75+: the V100 needs CUDA 12 and STRATA_EXPERIMENTAL_SM60 (docs/NVIDIA_V100.md).
# Roles: RTX 4090 = CUDA0 primary (dense, KV, MTP, prompt, hot experts); V100 = CUDA1 as --peer-device with
# STRATA_REMOTE_DIRECT=1 (docs/REMOTE_DIRECT.md: measurements and the env used in production).
#
# Stages from NVIDIA's official CUDA 12.8 images: `build` compiles (devel image, cmake, the toolchain); `prove` runs
# Strata's tests that need no GPU (ci/prove-0ics.py); the final stage carries only /opt/strata (engine, strata-vision,
# server, venv, llama.cpp's gguf-py, PROVE.txt = the tests that passed) on the runtime image.
# Built by .github/workflows/rilascio-0ics.yml on a release tag; by hand, context = this repository:
#   docker build -t strata-0ics:local -f Dockerfile.ubuntu-ai .
FROM nvidia/cuda:12.8.1-devel-ubuntu24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake curl git libatomic1 libgomp1 \
        python3 python3-pip python3-venv unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/strata
COPY . .

RUN python3 -m venv .venv \
    && .venv/bin/pip install --no-cache-dir --upgrade pip \
    && .venv/bin/pip install --no-cache-dir -r requirements.txt

ARG CUDA_ARCHITECTURES=70;89
ARG BUILD_VISION=1

# Like the upstream Dockerfile (setup.cmake_build + BUILD.json, so setup.py does not rebuild), plus the Volta flag and
# STRATA_PORTABLE: ggml's CPU backend for an AVX2 baseline, never the build host's. The image is built on GitHub's
# runners (AVX-512) and runs on a Ryzen 5600X (AVX2, no AVX-512): v0.1.42-0ics.1, built native, died at start with an
# illegal instruction in ggml_cpu_init. Strata's own AVX-512 kernels stay, chosen at run time by their CPU checks.
RUN .venv/bin/python - <<'PYEOF'
import json, os, pathlib, shutil
import setup

llama = setup.get_llama_cpp()
nvcc, _ = setup.find_nvcc()
arch = os.environ.get("CUDA_ARCHITECTURES", "70;89").strip().strip('"').replace(",", ";")
vision = "gpu" if os.environ.get("BUILD_VISION", "1") == "1" else "none"
setup.cmake_build(setup.ROOT, setup.ROOT / "build", "strata",
    ["-DSTRATA_ENABLE_CUDA=ON", "-DSTRATA_BUILD_TESTS=OFF", "-DSTRATA_EXPERIMENTAL_SM60=ON", "-DSTRATA_PORTABLE=ON",
     f"-DCMAKE_CUDA_ARCHITECTURES={arch}", f"-DCMAKE_CUDA_COMPILER={nvcc}",
     f"-DSTRATA_GGML_DIR={llama}"], None, "build-strata.bat")
if vision != "none":
    setup.cmake_build(setup.ROOT / "tools" / "vision", setup.ROOT / "build-vision", "strata-vision",
        [f"-DLLAMA_DIR={llama}", "-DSTRATA_VISION_CUDA=ON",
         f"-DCMAKE_CUDA_ARCHITECTURES={arch}", f"-DCMAKE_CUDA_COMPILER={nvcc}"], None, "build-vision.bat")
eng = setup.ROOT / "engine"
eng.mkdir(exist_ok=True)
shutil.copy2(setup.ROOT / "build" / setup.EXE, eng / setup.EXE)
if vision != "none":
    shutil.copy2(setup.ROOT / "build-vision" / "bin" / setup.VEXE, eng / setup.VEXE)
bindir = pathlib.Path(nvcc).parent
meta = {"source": "local", "version": setup.source_version(),
        "archs": [int(a.split("-")[0]) for a in arch.split(";") if a.split("-")[0].isdigit()], "vision": vision,
        "cuda_dirs": [str(d) for d in (bindir, bindir / "x64", bindir.parent / "lib64") if d.is_dir()],
        "src": setup.source_hash(setup.ENGINE_SOURCES),
        "vision_src": setup.source_hash(setup.VISION_SOURCES) if vision != "none" else None}
(eng / "BUILD.json").write_text(json.dumps(meta, indent=1))

# no image whose ggml follows the build host's CPU: GGML_NATIVE off and nothing above AVX2, engine and encoder alike
for cache in [setup.ROOT / "build" / "CMakeCache.txt"] + ([setup.ROOT / "build-vision" / "CMakeCache.txt"] if vision != "none" else []):
    righe = {r.split(":", 1)[0]: r.rsplit("=", 1)[-1] for r in cache.read_text().splitlines() if r.startswith("GGML_")}
    oltre = [k for k in ("GGML_NATIVE", "GGML_AVX512", "GGML_AVX512_VBMI", "GGML_AVX512_VNNI", "GGML_AVX512_BF16",
                         "GGML_AVX_VNNI", "GGML_AMX_TILE", "GGML_AMX_INT8", "GGML_AMX_BF16") if righe.get(k, "OFF") != "OFF"]
    assert righe.get("GGML_NATIVE") == "OFF" and not oltre, f"{cache}: ggml not portable: {oltre or 'GGML_NATIVE missing'}"
    print(f"{cache.parent.name}: ggml portable (AVX2 baseline)")
PYEOF

RUN rm -rf build build-vision

# --- Strata's tests that need no GPU (ci/prove-0ics.py): the final stage copies their summary, so no image without them
FROM build AS prove
RUN .venv/bin/pip install --no-cache-dir -r requirements-dev.txt \
    && .venv/bin/python ci/prove-0ics.py /tmp/PROVE.txt

# --- final image: the runtime CUDA libraries, python3 for the venv (same Ubuntu, same /usr/bin/python3), no toolchain
FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates libatomic1 libgomp1 python3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/strata /opt/strata
COPY --from=prove /tmp/PROVE.txt /opt/strata/PROVE.txt
WORKDIR /opt/strata
VOLUME ["/data"]
EXPOSE 8080
